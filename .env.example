# Copy this file to .env.local and fill in your real values.
# Supabase credentials (optional for seed reviews, required for live DB storage)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Search Console Verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token
NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-token
